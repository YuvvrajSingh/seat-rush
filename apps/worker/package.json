{
  "name": "@seatrush/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@seatrush/db": "workspace:*",
    "@seatrush/shared": "workspace:*",
    "bullmq": "^6.7.2",
    "ioredis": "^5.11.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
