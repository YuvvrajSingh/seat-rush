# Copy to .env. Never commit .env.
DATABASE_URL=postgresql://seatrush:seatrush@localhost:5433/seatrush
TEST_DATABASE_URL=postgresql://seatrush:seatrush@localhost:5433/seatrush_test
REDIS_URL=redis://localhost:6379
API_PORT=4000
# Browser origin allowed by API CORS
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
# HMAC secret for demo bearer tokens; generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=change-me
