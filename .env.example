# Copy to .env. Never commit .env.
# Required by both API and expiry worker (PostgreSQL remains the ownership authority).
DATABASE_URL=postgresql://seatrush:seatrush@localhost:5433/seatrush
TEST_DATABASE_URL=postgresql://seatrush:seatrush@localhost:5433/seatrush_test
REDIS_URL=redis://localhost:6379
API_PORT=4000
# Request-path Postgres pool size (Postgres max_connections is 100)
API_DB_POOL_MAX=20
# Browser origin allowed by API CORS
WEB_ORIGIN=http://localhost:3000
# Public web origin used for absolute Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
# HMAC secret for demo bearer tokens; generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=change-me
# HMAC secret shared by the payment simulator (worker) and the API; generate with: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=change-me
# Where the worker's payment simulator delivers notifications
PAYMENT_NOTIFICATION_URL=http://localhost:4000/payments/notifications
